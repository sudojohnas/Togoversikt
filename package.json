{
  "name": "togoversikt-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild frontend/app.js --bundle --minify --format=iife --outfile=public/app.js",
    "locations": "node scripts/update-locations.mjs",
    "test": "node --test",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "wrangler": "^4.141.0"
  }
}
