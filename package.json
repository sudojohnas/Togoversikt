{
  "name": "togoversikt-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild frontend/app.js --bundle --minify --format=iife --outfile=public/app.js",
    "check": "npm test && npm run build && git diff --exit-code -- public/app.js && npm audit --audit-level=high",
    "coverage": "node --test --experimental-test-coverage",
    "locations": "node scripts/update-locations.mjs",
    "test": "node --test",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.149.0"
  }
}
