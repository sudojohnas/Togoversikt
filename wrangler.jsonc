{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "togoversikt",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "limits": {
    "cpu_ms": 60000
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "kv_namespaces": [
    { "binding": "ROUTE_GRAPHS" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
